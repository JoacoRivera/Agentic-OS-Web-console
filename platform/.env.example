# Copy to platform/.env (gitignored). Loaded via --env-file-if-exists by
# npm run dev / start / verify / check:metrics-groundtruth.
# Path to the Agentic OS memory repo (default: ../../.. from server/src/).
REPO_ROOT=~/projects/agentic-os
# EXPOSE_RAW_CONTENT=false   # raw *content* over HTTP; metrics always computed (ADR-0005)
# PORT=3001
# HOST=127.0.0.1             # non-loopback without auth refuses to start (ADR-0005)
# LOCAL_HOSTNAME=agentic-os-console.localhost
# Optional local browser alias. A .localhost name resolves to loopback automatically.
# PROXY_HOSTNAME=aos-console.home.arpa  # authenticated reverse proxy only; see deploy/README.md
# PROXY_SECRET=                          # >= 32 chars, must match the proxy's X-AOS-Proxy-Auth
# HEALTH_REPO_ROOT=~/projects/Health-Management  # Family Health record (ADR-0010): separate private
#                                                 # clone, never a path inside REPO_ROOT; unset = section off
# FAMILY_HEALTH_ALLOW_PROXY=false        # keep false; true serves family health through the proxy
#                                        # and requires HEALTH_REPO_ROOT + the PROXY_* pair
# --- Finance / Firefly III (ADR-0011) ---------------------------------------
# Unset = the section does not exist. URL and token are set together.
# FIREFLY_URL=http://127.0.0.1:8081   # loopback on this host — NOT finances.home.arpa:
#                                     # plain http is allowed only for a loopback host so the
#                                     # token never crosses a network. Use https:// if remote.
# FIREFLY_TOKEN=                      # Personal Access Token (Options > Profile > OAuth), a long JWT
# FIREFLY_PUBLIC_URL=http://finances.home.arpa  # browser-facing, links only; never used for API calls
# FINANCE_ALLOW_PROXY=false           # keep false; true serves finance through the proxy and
#                                     # requires the FIREFLY_* pair + the PROXY_* pair
# FIREFLY_TIMEOUT_MS=8000
# FINANCE_CACHE_MS=60000
# FINANCE_MIN_TREND_MONTHS=3          # months of history a trend needs before it reports a value
